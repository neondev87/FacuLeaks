# ── Backend FacuLeaks — plantilla de variables de entorno ──
# Copiá este archivo a backend/.env y completá los valores reales.
# backend/.env NUNCA se commitea (ver .gitignore).

# Base de datos
DATABASE_URL="mysql://usuario:password@localhost:3306/faculeaks"

# Firma de los JWT de sesión del backend (usar un valor largo y aleatorio)
JWT_SECRET=""

# Secreto compartido SOLO entre el route server de Next
# (frontend/src/app/api/auth/sync-backend/route.js) y este backend.
# Protege POST /api/auth/login: sin este header el endpoint responde 403.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser IDÉNTICO al INTERNAL_API_SECRET del frontend/.env.local
INTERNAL_API_SECRET=""

# Origen permitido por CORS (frontend)
CORS_ORIGIN="http://localhost:3000"

# Red / puerto
PORT=4000
# Por defecto el server escucha solo en loopback (127.0.0.1).
# Para probar desde otro dispositivo en la LAN: HOST=0.0.0.0
HOST=127.0.0.1

# production => cookies con flag Secure
NODE_ENV=development

# Spotify OAuth (custom)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:4000/api/spotify/callback"
