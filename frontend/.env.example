# ── Frontend FacuLeaks — plantilla de variables de entorno ──
# Copiá este archivo a frontend/.env y completá los valores reales.
# frontend/.env NUNCA se commitea (ver .gitignore).

# URL pública de NextAuth (el propio frontend)
NEXTAUTH_URL="http://localhost:3000"

# Secreto de NextAuth (firma de los JWT de sesión del frontend).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secreto compartido SOLO entre el route server de Next
# (src/app/api/auth/sync-backend/route.js) y el backend.
# Debe ser IDÉNTICO al INTERNAL_API_SECRET de backend/.env.
INTERNAL_API_SECRET=""

# ── Backend Express ──
# URL base del backend para las llamadas DESDE EL BROWSER.
# En dev: http://localhost:4000 (también es el fallback si no se define).
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Opcional: URL del backend para llamadas SERVER-TO-SERVER (route handlers,
# callbacks de NextAuth). Si no se define, usa NEXT_PUBLIC_API_URL.
# Útil si el backend es alcanzable en una dirección interna distinta.
# API_INTERNAL_URL="http://localhost:4000"
